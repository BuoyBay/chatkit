    s += "r=\"5\" fill=\"#febc2e\"/><circle cx=\"46\" cy=\"13\" r=\"5\" fill=\"#28c840\"/><rect x=\"14\" y=\"40\" width=\"120\" height=\"146\" rx=\"6\" fill=\"#fff\"/><rect x=\"146\" y=\"40\" width=\"160\" height=\"70\" rx=\"6\" fill=\"url(#g)\"/><rect x=\"146\" y=\"120\" width=\"160\" height=\"12\" rx=\"4\" fill=\"#d6d6de\"/><rect x=\"146\" y=\"140\" width=\"110\" height=\"12\" rx=\"4\""
    s += " fill=\"#d6d6de\"/><rect x=\"146\" y=\"164\" width=\"64\" height=\"22\" rx=\"6\" fill=\"#7c6cf2\"/><rect x=\"24\" y=\"52\" width=\"90\" height=\"8\" rx=\"3\" fill=\"#cfcfd8\"/><rect x=\"24\" y=\"68\" width=\"70\" height=\"8\" rx=\"3\" fill=\"#cfcfd8\"/><rect x=\"24\" y=\"84\" width=\"96\" height=\"8\" rx=\"3\" fill=\"#cfcfd8\"/></svg>'),Ls=`I looked at \\`SettingsWindow.bui\\` "
    s += "and the screenshot. The layout breaks because the **Save** button is anchored to the window instead of the footer stack, so it overlaps the list when the window gets narrower than ~420px.\n"
    s += "\n"
    s += "## What's going on\n"
    s += "\n"
    s += "1. \\`FooterStack\\` uses a fixed \\`Width\\`, so it never shrinks.\n"
    s += "2. \\`SaveButton.Left\\` is computed once in \\`Opening\\` and never updated.\n"
    s += "   - Resizing doesn't re-run that code.\n"
    s += "   - On Windows the DPI scale makes it worse.\n"
    s += "3. The list has no bottom inset, so the last row hides under the footer.\n"
    s += "\n"
    s += "> Tip: anchors are cheaper than recomputing frames in \\`Resized\\` - see the [layout guide](https://docs.example.com/buoy/layout).\n"
    s += "\n"
    s += "## The fix\n"
    s += "\n"
    s += "Anchor the footer to the bottom edge and let the button follow it:\n"
    s += "\n"
    s += "\\`\\`\\`buoy\n"
    s += "' Keep the footer pinned and let the button float right.\n"
    s += "Public Sub LayoutFooter()\n"
    s += "    FooterStack.Anchors = Anchor.Left Or Anchor.Right Or Anchor.Bottom\n"
    s += "    Dim inset As Integer = 12\n"
    s += "    SaveButton.Left = FooterStack.Width - SaveButton.Width - inset\n"
    s += "    If SaveButton.Left < inset Then\n"
    s += "        SaveButton.Left = inset\n"
    s += "    End If\n"
    s += "    Return\n"
    s += "End Sub\n"
    s += "\\`\\`\\`\n"
    s += "\n"
    s += "The project settings stay the same, but I'd bump the minimum size:\n"
    s += "\n"
    s += "\\`\\`\\`json\n"
    s += "{ \"window\": { \"minWidth\": 360, \"minHeight\": 280, \"resizable\": true } }\n"
    s += "\\`\\`\\`\n"
    s += "\n"
    s += "| Width | Before | After |\n"
    s += "| --- | :---: | ---: |\n"
    s += "| 600px | OK | OK |\n"
    s += "| 420px | Overlap | OK |\n"
    s += "| 360px | Clipped | OK |\n"
    s += "\n"
    s += "You can verify with \\`buoy SettingsWindow.bui --check\\`, then run:\n"
    s += "\n"
    s += "\\`\\`\\`bash\n"
    s += "# rebuild and launch\n"
    s += "buoy main.bui -o app && ./app --window settings\n"
    s += "\\`\\`\\`\n"
    s += "\n"
    s += "I'll propose the edits now.`,Eu=`--- a/ui/SettingsWindow.bui\n"
    s += "+++ b/ui/SettingsWindow.bui\n"
    s += "@@ -12,8 +12,9 @@ Public Class SettingsWindow Inherits Window\n"
    s += "     Public Sub Opening()\n"
    s += "         Title = \"Settings\"\n"
    s += "-        FooterStack.Width = 420\n"
    s += "-        SaveButton.Left = 320\n"
    s += "+        FooterStack.Anchors = Anchor.Left Or Anchor.Right Or Anchor.Bottom\n"
    s += "+        LayoutFooter()\n"
    s += "         OptionsList.BottomInset = FooterStack.Height\n"
    s += "+        MinimumWidth = 360\n"
    s += "     End Sub\n"
    s += " \n"
    s += "     Public Sub Resized()\n"
    s += "@@ -48,4 +49,13 @@ Public Class SettingsWindow Inherits Window\n"
    s += "         Return True\n"
    s += "     End Function\n"
    s += " \n"
    s += "+    ' Keep the footer pinned and let the button float right.\n"
    s += "+    Public Sub LayoutFooter()\n"
    s += "+        Dim inset As Integer = 12\n"
    s += "+        SaveButton.Left = FooterStack.Width - SaveButton.Width - inset\n"
    s += "+        If SaveButton.Left < inset Then\n"
    s += "+            SaveButton.Left = inset\n"
    s += "+        End If\n"
    s += "+    End Sub\n"
    s += "+\n"
    s += " End Class\n"
    s += "\\\\ No newline at end of file`,Au=`--- a/project.json\n"
