''' An application-supplied provider descriptor; unavailable providers remain visible but cannot send.
Public Class ChatProvider
    Private Property mId As String
    Private Property mTitle As String
    Private Property mAvailable As Boolean
    Private Property mDetail As String

    Public Sub Constructor(providerId As String, title As String, available As Boolean, detail As String = "")
        If providerId = "" Or title = "" Then Throw New InvalidArgumentException("Provider ID and title are required")
        Me.mId = providerId
        Me.mTitle = title
        Me.mAvailable = available
        Me.mDetail = detail
    End Sub

    Public Property Id As String
        Get
            Return Me.mId
        End Get
    End Property
    Public Property Title As String
        Get
            Return Me.mTitle
        End Get
    End Property
    Public Property Available As Boolean
        Get
            Return Me.mAvailable
        End Get
    End Property
    Public Property Detail As String
        Get
            Return Me.mDetail
        End Get
    End Property
End Class

''' A project-item reference, not a copied file on disk. The host resolves its current revision.
Public Class ChatContext
    Private Property mId As String
    Private Property mTitle As String
    Private Property mVersion As Integer

    Public Sub Constructor(itemId As String, title As String, version As Integer)
        If itemId = "" Then Throw New InvalidArgumentException("Context item ID is required")
        Me.mId = itemId
        Me.mTitle = title
        Me.mVersion = version
    End Sub
    Public Property ItemId As String
        Get
            Return Me.mId
        End Get
    End Property
    Public Property Title As String
        Get
            Return Me.mTitle
        End Get
    End Property
    Public Property Version As Integer
        Get
            Return Me.mVersion
        End Get
    End Property
End Class

''' A user-chosen file (image or document) attached to the next prompt.
''' Images up to ImagePreviewLimit bytes carry an inline data URL for the transcript thumbnail.
Public Class ChatAttachment
    Public Const ImagePreviewLimit As Integer = 6291456
    Private Property mPath As String
    Private Property mName As String
    Private Property mKind As String
    Private Property mMimeType As String
    Private Property mSize As Integer
    Private Property mDataUrl As String

    Public Sub Constructor(filePath As String, name As String, kind As String, mimeType As String, size As Integer, dataUrl As String = "")
        If filePath = "" Then Throw New InvalidArgumentException("Attachment path is required")
        If kind <> "image" And kind <> "file" Then Throw New InvalidArgumentException("Attachment kind must be image or file")
        Me.mPath = filePath
        Me.mName = name
        If Me.mName = "" Then Me.mName = filePath
        Me.mKind = kind
        Me.mMimeType = mimeType
        Me.mSize = size
        Me.mDataUrl = dataUrl
    End Sub

    ''' Reads metadata (and a thumbnail for small images) from an existing file.
    Public Shared Function FromFile(item As FileSystemItem) As ChatAttachment
        If item = Nil Then Throw New InvalidArgumentException("Attachment file is required")
        If Not item.IsFile() Then Throw New InvalidArgumentException("Only files can be attached: " + item.Name())
        Dim mime As String = ChatMimeType(item.Ext())
        Dim size As Integer = item.Length()
        Dim kind As String = "file"
        Dim dataUrl As String = ""
        If String.StartsWith(mime, "image/", True) Then
            kind = "image"
            If size > 0 And size <= ChatAttachment.ImagePreviewLimit Then
                Dim opened As Result Of BinaryStream, IOError = BinaryStream.Open(item, False)
                If opened.IsOk Then
                    Dim stream As BinaryStream = opened.Value
                    Try
                        Dim data As Bytes = stream.Read(stream.Length)
                        dataUrl = "data:" + mime + ";base64," + data.ToBase64()
                    Finally
                        stream.Close()
                    End Try
                End If
            End If
        End If
        Return New ChatAttachment(item.FullPath(), item.Name(), kind, mime, size, dataUrl)
    End Function

    Public Property Path As String
        Get
            Return Me.mPath
        End Get
    End Property
    Public Property Name As String
        Get
            Return Me.mName
        End Get
    End Property
    ''' "image" or "file".
    Public Property Kind As String
        Get
            Return Me.mKind
        End Get
    End Property
    Public Property MimeType As String
        Get
            Return Me.mMimeType
        End Get
    End Property
    Public Property Size As Integer
        Get
            Return Me.mSize
        End Get
    End Property
    Public Property DataUrl As String
        Get
            Return Me.mDataUrl
        End Get
    End Property

    Internal Function ToJSON() As JSONItem
        Dim value As JSONItem = JSONItem.NewObject()
        value.Value("name") = Me.mName
        value.Value("kind") = Me.mKind
        value.Value("path") = Me.mPath
        If Me.mDataUrl <> "" Then value.Value("dataUrl") = Me.mDataUrl
        value.Value("detail") = ChatByteSize(Me.mSize)
        Return value
    End Function
End Class

''' One file inside a proposal card; DiffText is a unified diff the host computed.
Public Class ChatFileChange
    Private Property mPath As String
    Private Property mRevision As Integer
    Private Property mDiff As String
    Private Property mAdded As Integer
    Private Property mRemoved As Integer

    Public Sub Constructor(filePath As String, revision As Integer, diffText As String)
        If filePath = "" Then Throw New InvalidArgumentException("Changed file path is required")
        Me.mPath = filePath
        Me.mRevision = revision
        Me.mDiff = diffText
        For Each line As String In String.Split(diffText, "\n")
            If String.StartsWith(line, "+++", True) Or String.StartsWith(line, "---", True) Then Continue For
            If String.StartsWith(line, "+", True) Then Me.mAdded += 1
            If String.StartsWith(line, "-", True) Then Me.mRemoved += 1
        Next
    End Sub
    Public Property Path As String
        Get
            Return Me.mPath
        End Get
    End Property
    Public Property Revision As Integer
        Get
            Return Me.mRevision
        End Get
    End Property
    Public Property DiffText As String
        Get
            Return Me.mDiff
        End Get
    End Property
    Public Property Added As Integer
        Get
            Return Me.mAdded
        End Get
    End Property
    Public Property Removed As Integer
        Get
            Return Me.mRemoved
        End Get
    End Property
End Class

Public Interface ChatPanelHost
    Sub SendMessage(providerId As String, prompt As String, contextIds As Array Of String)
    Sub CancelTurn()
    Sub ApproveProposal(proposalId As String)
    Sub RejectProposal(proposalId As String)
    Sub ProviderChanged(providerId As String)
    Sub ResolvePermission(allow As Boolean)
    Sub SignInWithChatGPT()
End Interface

''' Optional host capabilities. When the host implements this interface the account
''' button toggles between sign-in and sign-out, and transcript links/files open in the host.
Public Interface ChatPanelAccountHost
    Sub SignOutOfChatGPT()
    Sub OpenChatFile(filePath As String)
    Sub OpenChatLink(url As String)
End Interface

''' Optional host capability: notified when the user switches between the web and
''' native transcripts from the panel, so the host can persist the choice.
Public Interface ChatPanelViewHost
    Sub TranscriptModeChanged(plainTranscript As Boolean)
End Interface

Public Function ChatMimeType(fileExt As String) As String
    Select Case String.LCase(fileExt)
        Case "png"
            Return "image/png"
        Case "jpg", "jpeg"
            Return "image/jpeg"
        Case "gif"
            Return "image/gif"
        Case "webp"
            Return "image/webp"
        Case "bmp"
            Return "image/bmp"
        Case "svg"
            Return "image/svg+xml"
        Case "pdf"
            Return "application/pdf"
        Case "json"
            Return "application/json"
        Case "md", "markdown"
            Return "text/markdown"
        Case "bui", "txt", "log", "csv", "c", "h", "py", "js", "ts", "html", "css", "xml", "yml", "yaml", "toml", "sh"
            Return "text/plain"
    End Select
    Return "application/octet-stream"
End Function

Public Function ChatByteSize(size As Integer) As String
    If size < 0 Then Return ""
    If size < 1024 Then Return String.From(size) + " B"
    If size < 1048576 Then Return String.From((size + 512) \ 1024) + " KB"
    Dim tenths As Integer = (size * 10 + 524288) \ 1048576
    Return String.From(tenths \ 10) + "." + String.From(tenths Mod 10) + " MB"
End Function

Private Class ChatActionButton Inherits Button
    Public Property Owner As Weak ChatPanel
    Public Property ActionName As String
    Private Property mProgrammatic As Boolean = False
    Private Property mActionError As Exception = Nil
    Public Sub InvokeAction()
        If Me.mProgrammatic Then Return
        Me.mProgrammatic = True
        Me.mActionError = Nil
        Try
            If Me.Visible Then
                Me.PerformClick()
            Else
                ' Inline (rich transcript) cards replace hidden native buttons; act directly.
                Dim target As ChatPanel = Me.Owner
                If target <> Nil Then target.Activate(Me.ActionName)
            End If
        Catch e As Exception
            Me.mActionError = e
        Finally
            Me.mProgrammatic = False
        End Try
        Dim actionError As Exception = Me.mActionError
        Me.mActionError = Nil
        If actionError <> Nil Then Throw actionError
    End Sub
    Handle Action()
        Dim target As ChatPanel = Me.Owner
        If target = Nil Then Return
        If Me.mProgrammatic Then
            Try
                target.Activate(Me.ActionName)
            Catch e As Exception
                Me.mActionError = e
            End Try
        Else
            Try
                target.Activate(Me.ActionName)
            Catch e As Exception
                ' Never let status-reporting failures unwind the native callback.
                Try
                    target.SetStatus("Action failed: " + e.Message)
                Catch reportError As Exception
                End Try
            End Try
        End If
    End Handle
End Class

Private Class ChatProviderPicker Inherits ComboBox
    Public Property Owner As Weak ChatPanel
    Handle SelectionChanged()
        Dim target As ChatPanel = Me.Owner
        If target <> Nil Then target.NotifyProviderChanged()
    End Handle
End Class

''' The rich transcript surface. Only the in-memory document may load.
Private Class ChatTranscriptView Inherits HTMLView
    Public Property Owner As Weak ChatPanel
    Handle JavaScriptRequest()
        ' An exception escaping an event handler would terminate the app.
        Try
            Dim message As String = Me.Message
            Dim target As ChatPanel = Me.Owner
            If target <> Nil Then
                Try
                    target.AcceptPageMessage(message)
                Catch actionError As Exception
                    target.SetStatus("Action failed: " + actionError.Message)
                End Try
            End If
        Catch e As Exception
        End Try
    End Handle
    Handle CancelLoad(url As String) As Boolean
        Return Not (String.Left(url, 6) = "about:" Or String.Left(url, 5) = "data:")
    End Handle
End Class

''' Detects a transcript engine that never starts (missing WebKitGTK, GPU-less host).
Private Class ChatPanelTicker Inherits Timer
    Public Property Owner As Weak ChatPanel
    Public Overrides Sub NotifyTick()
        Dim target As ChatPanel = Me.Owner
        If target <> Nil Then target.Tick()
    End Sub
End Class

''' Delivers queued transcript scripts on the next main-loop turn, one call per batch.
Private Class ChatScriptFlusher Inherits Timer
    Public Property Owner As Weak ChatPanel
    Public Overrides Sub NotifyTick()
        Me.Stop()
        Dim target As ChatPanel = Me.Owner
        If target <> Nil Then target.FlushScripts()
    End Sub
End Class

#If TargetLinux Then
    Private Declare Function ChatKitSetEnv Lib "c" Alias "setenv" (name As String, value As String, overwrite As Int32) As Int32
#End If

Private Class ChatDropTarget Implements IDropTarget
    Public Property Owner As Weak ChatPanel
    Public Overrides Function DragEntered(payload As DragItem, requested As DragAction) As DragAction
        If payload.HasType(DragType.FileList) Then Return DragAction.Copy
        Return DragAction.None
    End Function
    Public Overrides Function DragOver(payload As DragItem, requested As DragAction, pt As Point) As DragAction
        If payload.HasType(DragType.FileList) Then Return DragAction.Copy
        Return DragAction.None
    End Function
    Public Overrides Sub DragLeft()
    End Sub
    Public Overrides Function DragDropped(payload As DragItem, action As DragAction, pt As Point) As Boolean
        Dim target As ChatPanel = Me.Owner
        If target = Nil Or Not payload.HasType(DragType.FileList) Then Return False
        If target.IsBusy Then
            target.SetStatus("Attach files after the current turn")
            Return False
        End If
        Try
            For Each item As FileSystemItem In payload.AsFiles()
                target.AttachFile(item)
            Next
        Catch e As Exception
            target.SetStatus("Attachment failed: " + e.Message)
        End Try
        Return True
    End Function
End Class

''' A native, main-thread-only panel. The host owns transport, project edits and authentication.
''' The transcript renders in an embedded HTMLView (markdown, inline tool calls, diff and
''' approval cards, attachments, turn stats) and falls back to plain native text when no web
''' engine is available. Set BUOY_CHATKIT_PLAIN=1 to force the plain transcript.
Public Class ChatPanel Inherits View
    Public Const RichTimeoutMicroseconds As Integer = 6000000
    Private Property mHost As ChatPanelHost
    Private Property mProviders As Array Of ChatProvider = []
    Private Property mContext As Array Of ChatContext = []
    Private Property mBusy As Boolean = False
    Private Property mSending As Boolean = False
    Private Property mAuthenticated As Boolean = False
    Private Property mAuthBusy As Boolean = False
    Private Property mPermission As Boolean = False
    Private Property mPermissionCanAccept As Boolean = True
    Private Property mProposalId As String
    Private Property mCardId As String
    Private Property mCardCounter As Integer = 0
    Private Property mTranscript As String
    Private Property mTools As Map Of String, String = New Map Of String, String()
    Private Property mToolOrder As Array Of String = []
    Private Property mProvider As ChatProviderPicker = New ChatProviderPicker()
    Private Property mModel As ComboBox = New ComboBox()
    Private Property mModelIds As Array Of String = []
    Private Property mHeading As Label = New Label()
    Private Property mContextLabel As Label = New Label()
    Private Property mTranscriptArea As TextArea = New TextArea()
    ' Created on first web use so the plain transcript never loads a web engine.
    Private Property mTranscriptView As ChatTranscriptView
    Private Property mActivity As TextArea = New TextArea()
    Private Property mProposal As TextArea = New TextArea()
    Private Property mComposer As TextArea = New TextArea()
    Private Property mAttachmentsLabel As Label = New Label()
    Private Property mAuth As ChatActionButton = New ChatActionButton()
    Private Property mAttach As ChatActionButton = New ChatActionButton()
    Private Property mClearAttachments As ChatActionButton = New ChatActionButton()
    Private Property mSend As ChatActionButton = New ChatActionButton()
    Private Property mCancel As ChatActionButton = New ChatActionButton()
    Private Property mApprove As ChatActionButton = New ChatActionButton()
    Private Property mReject As ChatActionButton = New ChatActionButton()
    Private Property mCopyAll As ChatActionButton = New ChatActionButton()
    Private Property mViewMode As ChatActionButton = New ChatActionButton()
    ' Last focus state the web page reported (window focus/blur inside the page).
    Private Property mPageFocused As Boolean = False
    ' When the page last lost focus. Opening a GTK/Win32 menu can blur the page just
    ' before the menu command runs, so a recent blur still counts as transcript focus.
    Private Property mPageBlurAt As Integer = 0
    Private Const BlurGraceMicroseconds As Integer = 1500000
    Private Property mStatus As Label = New Label()
    Private Property mWidth As Integer = 500
    Private Property mHeight As Integer = 720
    ' Rich transcript state: 0 loading, 1 ready, 2 plain fallback.
    Private Property mRichState As Integer = 0
    Private Property mLoadStarted As Integer = 0
    Private Property mTicker As ChatPanelTicker = New ChatPanelTicker()
    Private Property mDropTarget As ChatDropTarget = New ChatDropTarget()
    Private Property mDark As Integer = -1
    Private Property mPendingScript As String = ""
    Private Property mFlushScheduled As Boolean = False
    Private Property mFlusher As ChatScriptFlusher = New ChatScriptFlusher()
    ' Replayable model of the transcript: ordered operations, coalesced by key.
    Private Property mOps As Array Of JSONItem = []
    Private Property mOpIndex As Map Of String, Integer = New Map Of String, Integer()
    Private Property mMessageCounter As Integer = 0
    ' The open assistant reply segment ("" when closed), the last segment shown (turn
    ' stats live there), its author, and whether the next segment continues the reply.
    Private Property mAssistantId As String
    Private Property mLastAssistantId As String
    Private Property mStatsId As String
    Private Property mAssistantAuthor As String
    Private Property mAssistantContinues As Boolean = False
    Private Property mEmptyState As JSONItem
    ' Attachments queued for the next prompt, and those being sent right now.
    Private Property mAttachments As Array Of ChatAttachment = []
    Private Property mSendingAttachments As Array Of ChatAttachment = []
    ' Per-turn stream statistics (estimated unless the host supplies usage).
    Private Property mStreamStart As Integer = 0
    Private Property mStreamChars As Integer = 0
    Private Property mStatsSent As Integer = 0
    Private Property mUsageIn As Integer = 0
    Private Property mUsageOut As Integer = 0

    Public Sub Constructor()
        Super.Constructor()
        Me.mHeading.Text = "Agent"
        Me.mHeading.FontSize = 13.0
        Me.mHeading.Bold = True
        Me.mContextLabel.FontSize = 11.0
        Me.mStatus.FontSize = 11.0
        Me.mAttachmentsLabel.FontSize = 11.0
        Me.mProvider.Owner = Me
        Me.mTranscriptArea.IsReadOnly = True
        Me.mActivity.IsReadOnly = True
        Me.mActivity.FontSize = 11.0
        Me.mProposal.IsReadOnly = True
        Me.mProposal.FontName = "monospace"
        Me.mProposal.FontSize = 11.0
        Me.mComposer.WordWrap = True
        Me.ConfigureButton(Me.mAuth, "Sign in with ChatGPT", "auth")
        Me.ConfigureButton(Me.mAttach, "Attach…", "attach")
        Me.ConfigureButton(Me.mClearAttachments, "Clear", "clear-attachments")
        Me.ConfigureButton(Me.mSend, "Send", "send")
        Me.ConfigureButton(Me.mCancel, "Stop", "cancel")
        Me.ConfigureButton(Me.mApprove, "Apply changes", "approve")
        Me.ConfigureButton(Me.mReject, "Reject", "reject")
        Me.ConfigureButton(Me.mCopyAll, "Copy chat", "copy-transcript")
        Me.ConfigureButton(Me.mViewMode, "Native view", "toggle-view")
        Me.AddSubview(Me.mAuth)
        Me.AddSubview(Me.mHeading)
        Me.AddSubview(Me.mProvider)
        Me.mModel.Visible = False
        Me.AddSubview(Me.mModel)
        Me.AddSubview(Me.mContextLabel)
        Me.AddSubview(Me.mCopyAll)
        Me.AddSubview(Me.mViewMode)
        Me.AddSubview(Me.mTranscriptArea)
        Me.AddSubview(Me.mActivity)
        Me.AddSubview(Me.mProposal)
        Me.AddSubview(Me.mAttachmentsLabel)
        Me.AddSubview(Me.mClearAttachments)
        Me.AddSubview(Me.mComposer)
        Me.AddSubview(Me.mAttach)
        Me.AddSubview(Me.mSend)
        Me.AddSubview(Me.mCancel)
        Me.AddSubview(Me.mApprove)
        Me.AddSubview(Me.mReject)
        Me.AddSubview(Me.mStatus)
        Me.mDropTarget.Owner = Me
        Dim accepted As Array Of DragType = [DragType.FileList]
        Me.mComposer.RegisterDropTarget(Me.mDropTarget, accepted)
        Me.RegisterDropTarget(Me.mDropTarget, accepted)
        Dim emptyContext As Array Of ChatContext = []
        Me.SetContext(emptyContext)
        Me.ClearProposal()
        Me.RefreshAttachments()
        If ChatPanel.WebTranscriptBlocker() = "" Then
            ' Loading: the page is created on the first timer tick, after host setup.
            Me.mRichState = 0
            Me.mLoadStarted = 0
            Me.mTicker.Owner = Me
            Me.mTicker.Period = 250
            Me.mTicker.Start()
        Else
            Me.mRichState = 2
        End If
        Me.ApplyTranscriptMode()
        Me.LayoutPanel(500, 720)
        Me.RefreshEnabled()
    End Sub

    Private Sub ConfigureButton(button As ChatActionButton, caption As String, actionName As String)
        button.Owner = Me
        button.Caption = caption
        button.ActionName = actionName
    End Sub

    Public Sub AttachHost(host As ChatPanelHost)
        Me.mHost = host
        Me.RefreshAuthCaption()
        Me.RefreshEnabled()
    End Sub

    ' ── Rich transcript plumbing ─────────────────────────────────────────────

    ''' True once the HTML transcript has loaded and is receiving updates.
    Public Property RichTranscriptActive As Boolean
        Get
            Return Me.mRichState = 1
        End Get
    End Property

    ''' True when the panel shows the plain native transcript (no web engine, or forced).
    Public Property PlainTranscript As Boolean
        Get
            Return Me.mRichState = 2
        End Get
    End Property

    Internal Sub Tick()
        If Me.mRichState = 0 And Me.mLoadStarted = 0 Then
            Me.LoadTranscriptPage()
            Return
        End If
        If Me.mRichState = 0 And System.Microseconds() - Me.mLoadStarted > ChatPanel.RichTimeoutMicroseconds Then
            Me.UsePlainTranscript()
        End If
        If Me.mRichState <> 0 Then Me.mTicker.Stop()
    End Sub

    ''' Switch to the plain native transcript (also used when the web engine never starts).
    Public Sub UsePlainTranscript()
        If Me.mRichState = 2 Then Return
        Me.mRichState = 2
        Me.mTicker.Stop()
        Me.ApplyTranscriptMode()
        Me.LayoutPanel(Me.mWidth, Me.mHeight)
        Me.RefreshEnabled()
    End Sub

    ''' Why the web transcript cannot run here, or "" when it can. WebKitGTK aborts the whole
    ''' process when its bubblewrap sandbox cannot create user namespaces (containers, hosts
    ''' with max_user_namespaces=0), so those hosts use the native transcript instead.
    ''' BUOY_CHATKIT_PLAIN=1 forces native; WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS skips the check.
    Public Shared Function WebTranscriptBlocker() As String
        If System.EnvironmentVariable("BUOY_CHATKIT_PLAIN").Or("") = "1" Then Return "BUOY_CHATKIT_PLAIN=1"
        #If TargetLinux Then
            If System.EnvironmentVariable("WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS").Or("") <> "" Then Return ""
            Dim dockerMarker As New FileSystemItem("/.dockerenv")
            Dim podmanMarker As New FileSystemItem("/run/.containerenv")
            If dockerMarker.Exists() Or podmanMarker.Exists() Then Return "container without a WebKit sandbox"
            Dim limitFile As New FileSystemItem("/proc/sys/user/max_user_namespaces")
            If limitFile.Exists() And String.Trim(limitFile.ReadAllText().Or("1")) = "0" Then Return "user namespaces are disabled"
        #End If
        Return ""
    End Function

    ''' Switch (back) to the web transcript. The full conversation is replayed once the
    ''' page reports ready; if it never does, the panel returns to the plain transcript.
    Public Sub UseRichTranscript()
        If Me.mRichState <> 2 Then Return
        Dim blocker As String = ChatPanel.WebTranscriptBlocker()
        If blocker <> "" Then
            Me.SetStatus("Web transcript unavailable: " + blocker)
            Return
        End If
        Me.mRichState = 0
        Me.LoadTranscriptPage()
        Me.mTicker.Owner = Me
        Me.mTicker.Period = 250
        Me.mTicker.Start()
    End Sub

    Private Sub EnsureTranscriptView()
        If Me.mTranscriptView <> Nil Then Return
        ChatPanel.PrepareWebEngine()
        Me.mTranscriptView = New ChatTranscriptView()
        Me.mTranscriptView.Owner = Me
        Me.AddSubview(Me.mTranscriptView)
    End Sub

    Private Sub LoadTranscriptPage()
        Me.EnsureTranscriptView()
        Me.ApplyTranscriptMode()
        Me.mLoadStarted = System.Microseconds()
        Me.mTranscriptView.LoadHTML(ChatTranscriptHTML())
        Me.LayoutPanel(Me.mWidth, Me.mHeight)
        Me.RefreshEnabled()
    End Sub

    Private Sub ApplyTranscriptMode()
        Dim plain As Boolean = Me.mRichState = 2
        If plain Then
            Me.mPageFocused = False
            Me.mPageBlurAt = 0
        End If
        Me.mViewMode.Caption = If(plain, "Web view", "Native view")
        If Me.mTranscriptView <> Nil Then Me.mTranscriptView.Visible = Not plain
        Me.mTranscriptArea.Visible = plain
        If plain Then
            Me.mTranscriptArea.Text = Me.DisplayText(Me.mTranscript)
            Me.RenderActivity()
        Else
            ' The page owns the transcript; free the hidden native copy.
            Me.mTranscriptArea.Text = ""
        End If
    End Sub

    Internal Sub AcceptPageMessage(message As String)
        If String.LenBytes(message) > 1048576 Then Return
        ' Page messages are untrusted input: ignore anything that is not a JSON object.
        Dim parsed As JSONItem
        Try
            parsed = Json.Parse(message)
        Catch e As Exception
            Return
        End Try
        If parsed = Nil Or Not parsed.IsObject() Then Return
        Dim action As String = parsed.Value("action").AsString().Or("")
        Dim id As String = parsed.Value("id").AsString().Or("")
        Select Case action
            Case "ready"
                Me.OnTranscriptReady()
            Case "fallback"
                Me.UsePlainTranscript()
            Case "approve", "reject"
                ' Ignore stale buttons from resolved cards.
                If id <> "" And id = Me.mCardId Then Me.Activate(action)
            Case "suggest"
                Me.mComposer.Text = parsed.Value("text").AsString().Or("")
                Me.mComposer.SetFocus()
            Case "copy"
                Dim board As New Clipboard()
                board.Text = parsed.Value("text").AsString().Or("")
                Me.SetStatus("Copied to clipboard")
            Case "copySelection"
                ' Reply to CopyTranscriptSelection(); an empty selection copies nothing.
                Dim selected As String = parsed.Value("text").AsString().Or("")
                If selected = "" Then
                    Me.SetStatus("Select transcript text to copy, or use Copy chat")
                Else
                    Dim board As New Clipboard()
                    board.Text = selected
                    Me.SetStatus("Copied selection")
                End If
            Case "focus"
                Dim focused As Boolean = parsed.Value("focused").AsBoolean().Or(False)
                If Me.mPageFocused And Not focused Then Me.mPageBlurAt = System.Microseconds()
                Me.mPageFocused = focused
            Case "openFile", "link"
                Dim account As ChatPanelAccountHost = TryCast(Me.mHost, ChatPanelAccountHost)
                If account = Nil Then Return
                If action = "openFile" Then
                    account.OpenChatFile(parsed.Value("path").AsString().Or(""))
                Else
                    Dim url As String = parsed.Value("url").AsString().Or("")
                    If String.StartsWith(url, "http://", False) Or String.StartsWith(url, "https://", False) Then account.OpenChatLink(url)
                End If
        End Select
    End Sub

    Private Sub OnTranscriptReady()
        If Me.mRichState = 2 Then Return
        Me.EnsureTranscriptView()
        Me.mPendingScript = ""
        Me.mRichState = 1
        Me.mTicker.Stop()
        Me.ApplyTranscriptMode()
        Dim script As String = "chat.reset();"
        script += Me.ThemeScript()
        If Me.mEmptyState <> Nil Then script += "chat.setEmpty(" + Json.Stringify(Me.mEmptyState) + ");"
        For Each op As JSONItem In Me.mOps
            script += Me.OpScript(op)
        Next
        script += Me.BusyScript()
        Me.Run(script)
        Me.LayoutPanel(Me.mWidth, Me.mHeight)
        Me.RefreshEnabled()
    End Sub

    Private Function OpScript(op As JSONItem) As String
        Return "chat." + op.Value("fn").AsString().Or("noop") + "(" + Json.Stringify(op.Value("args")) + ");"
    End Function

    Private Function ThemeScript() As String
        If Me.mDark < 0 Then Return ""
        Return "chat.setTheme({\"dark\":" + If(Me.mDark = 1, "true", "false") + "});"
    End Function

    Private Function BusyScript() As String
        Dim args As JSONItem = JSONItem.NewObject()
        args.Value("busy") = Me.mBusy
        args.Value("label") = If(Me.mStatus.Text = "", "Thinking…", Me.mStatus.Text)
        Return "chat.setBusy(" + Json.Stringify(args) + ");"
    End Function

    ''' Queues a script; streaming deltas and card updates reach the page in one batch per
    ''' main-loop turn instead of one ExecuteJavaScript call each.
    Private Sub Run(script As String)
        If Me.mRichState <> 1 Or Me.mTranscriptView = Nil Then Return
        Me.mPendingScript += script
        If Me.mFlushScheduled Then Return
        Me.mFlushScheduled = True
        Me.mFlusher.Owner = Me
        Me.mFlusher.Period = 16
        ' Explicit stopping keeps batching single-shot and permits safe restarts.
        Me.mFlusher.Count = -1
        Me.mFlusher.Start()
    End Sub

    Internal Sub FlushScripts()
        Me.mFlushScheduled = False
        Dim script As String = Me.mPendingScript
        Me.mPendingScript = ""
        If script = "" Or Me.mRichState <> 1 Or Me.mTranscriptView = Nil Then Return
        Me.mTranscriptView.ExecuteJavaScript(script)
    End Sub

    ''' WebKitGTK's DMA-BUF renderer stops repainting the page once a native control
    ''' (the composer) takes focus on hosts without a working GPU buffer path, so the
    ''' transcript uses shared-memory rendering unless the user chose otherwise.
    Private Shared Sub PrepareWebEngine()
        #If TargetLinux Then
            If System.EnvironmentVariable("WEBKIT_DISABLE_DMABUF_RENDERER").Or("") = "" Then
                Dim ignored As Int32 = ChatKitSetEnv("WEBKIT_DISABLE_DMABUF_RENDERER", "1", 0)
            End If
        #End If
    End Sub

    ''' Records an operation for replay and sends it live. A non-empty key coalesces
    ''' later operations with the same key into the original transcript position.
    Private Sub Emit(fn As String, args As JSONItem, key As String = "")
        Dim op As JSONItem = JSONItem.NewObject()
        op.Value("fn") = fn
        op.Value("args") = args
        If key <> "" And Me.mOpIndex.ContainsKey(key) Then
            Me.mOps(Me.mOpIndex.Get(key).Or(0)) = op
        Else
            If key <> "" Then Me.mOpIndex.Set(key, Array.Count(Me.mOps))
            Me.mOps.Append(op)
        End If
        Me.Run(Me.OpScript(op))
    End Sub

    ''' A card shown again (same id) is live again: neutralise its earlier resolution so a
    ''' replay does not end with the old outcome after the re-shown card.
    Private Sub ReviveCard(cardId As String)
        If Not Me.mOpIndex.ContainsKey("resolve:" + cardId) Then Return
        Dim args As JSONItem = JSONItem.NewObject()
        args.Value("id") = cardId
        args.Value("outcome") = ""
        Me.Emit("resolveCard", args, "resolve:" + cardId)
    End Sub

    Private Function FindOp(key As String) As JSONItem
        If Not Me.mOpIndex.ContainsKey(key) Then Return Nil
        Return Me.mOps(Me.mOpIndex.Get(key).Or(0)).Value("args")
    End Function

    ''' Forces the transcript palette; by default it follows the system appearance.
    Public Sub SetDarkAppearance(dark As Boolean)
        Me.mDark = If(dark, 1, 0)
        Me.Run(Me.ThemeScript())
    End Sub

    ''' Hero shown while the transcript is empty; suggestion chips fill the composer.
    Public Sub SetEmptyState(title As String, subtitle As String, suggestions As Array Of String)
        Dim args As JSONItem = JSONItem.NewObject()
        args.Value("title") = title
        args.Value("subtitle") = subtitle
        Dim list As JSONItem = JSONItem.NewArray()
        For Each suggestion As String In suggestions
            list.Add(JSONItem.From(suggestion))
        Next
        args.Value("suggestions") = list
        Me.mEmptyState = args
        Me.Run("chat.setEmpty(" + Json.Stringify(args) + ");")
    End Sub

    ''' Clears the conversation (transcript, tool activity, statistics).
    Public Sub ClearTranscript()
        If Me.mBusy Then Throw New InvalidArgumentException("Cannot clear the transcript during a turn")
        If Me.mCardId <> "" Then Throw New InvalidArgumentException("Resolve the pending proposal or permission first")
        Me.mTranscript = ""
        Me.mTools.Clear()
        Me.mToolOrder = []
        Me.mOps = []
        Me.mOpIndex.Clear()
        Me.mAssistantId = ""
        Me.mLastAssistantId = ""
        Me.mStatsId = ""
        Me.mAssistantAuthor = ""
        Me.mAssistantContinues = False
        Me.mTranscriptArea.Text = ""
        Me.mActivity.Text = ""
        Me.Run("chat.reset();")
        Me.LayoutPanel(Me.mWidth, Me.mHeight)
    End Sub

    ' ── Account ──────────────────────────────────────────────────────────────

    ''' The host publishes verified identity and pending authentication independently of chat turns.
    ''' One button toggles: "Sign in with ChatGPT" while signed out, "Sign out" while signed in.
    Public Sub SetAuthenticationState(signedIn As Boolean, busy As Boolean = False)
        If Me.mAuthenticated = signedIn And Me.mAuthBusy = busy Then Return
        Me.mAuthenticated = signedIn
        Me.mAuthBusy = busy
        Me.RefreshAuthCaption()
        Me.RefreshEnabled()
        Me.LayoutPanel(Me.mWidth, Me.mHeight)
    End Sub

    Private Sub RefreshAuthCaption()
        If Me.mAuthBusy Then
            Me.mAuth.Caption = If(Me.mAuthenticated, "Working…", "Signing in…")
        ElseIf Me.mAuthenticated Then
            If TryCast(Me.mHost, ChatPanelAccountHost) <> Nil Then
                Me.mAuth.Caption = "Sign out"
            Else
                Me.mAuth.Caption = "Signed in with ChatGPT"
            End If
        Else
            Me.mAuth.Caption = "Sign in with ChatGPT"
        End If
    End Sub

    Public Property AuthenticationCaption As String
        Get
            Return Me.mAuth.Caption
        End Get
    End Property

    ''' Show account actions only for the backend that owns this authentication flow.
    Public Sub SetAuthenticationVisible(visible As Boolean)
        Me.mAuth.Visible = visible
        Me.RefreshEnabled()
        Me.LayoutPanel(Me.mWidth, Me.mHeight)
    End Sub

    Public Property AuthenticationVisible As Boolean
        Get
            Return Me.mAuth.Visible
        End Get
    End Property

    ''' Call when closing the host window to release callbacks and stop accepting sends.
    Public Sub DetachHost()
        Me.mHost = Nil
        Me.mTicker.Stop()
        Me.mFlusher.Stop()
        Me.RefreshEnabled()
    End Sub

    ' ── Providers, models, context ───────────────────────────────────────────

    Public Sub SetProviders(providers As Array Of ChatProvider)
        If Me.mBusy Then Throw New InvalidArgumentException("Cannot change providers during a turn")
        Dim seen As New Set Of String()
        For Each descriptor As ChatProvider In providers
            If descriptor = Nil Then Throw New InvalidArgumentException("Nil provider")
            If seen.Contains(descriptor.Id) Then Throw New InvalidArgumentException("Duplicate provider ID")
            seen.Add(descriptor.Id)
        Next
        Me.mProviders = Array.Clone(providers)
        Me.mProvider.RemoveAllItems()
        For Each descriptor As ChatProvider In providers
            Dim title As String = descriptor.Title
            If Not descriptor.Available Then title += " · not configured"
            Me.mProvider.AddItem(title)
        Next
        If Array.Count(providers) > 0 Then Me.mProvider.SelectedIndex = 0
        Me.NotifyProviderChanged()
    End Sub

    ' Catalog entries are supplied by the selected backend; an empty catalog hides the picker.
    Public Sub SetModels(models As JSONItem, selectedModel As String = "")
        If Me.mBusy Then Throw New InvalidArgumentException("Cannot change models during a turn")
        If models = Nil Then Throw New InvalidArgumentException("Model catalog is required")
        If Not models.IsArray() Or models.Count() > 512 Then Throw New InvalidArgumentException("Invalid model catalog")
        Dim ids As Array Of String = []
        ids.Append("")
        Dim titles As Array Of String = []
        titles.Append("Model: provider default")
        Dim seen As New Set Of String()
        For index As Integer = 0 To models.Count() - 1
            Dim entry As JSONItem = models.ValueAt(index)
            Dim id As String = entry.Value("model").AsString().Or("")
            If id = "" Or String.LenBytes(id) > 256 Then Throw New InvalidArgumentException("Invalid model ID")
            If seen.Contains(id) Then Throw New InvalidArgumentException("Duplicate model ID")
            seen.Add(id)
            ids.Append(id)
            Dim title As String = entry.Value("displayName").AsString().Or(id)
            If title = "" Then title = id
            titles.Append(String.Left(title, 256))
        Next
        Me.mModelIds = ids
        Me.mModel.RemoveAllItems()
        For Each title As String In titles
            Me.mModel.AddItem(title)
        Next
        Me.mModel.SelectedIndex = 0
        For index As Integer = 0 To Array.Count(ids) - 1
            If ids(index) = selectedModel Then Me.mModel.SelectedIndex = index
        Next
        Me.mModel.Visible = models.Count() > 0
        Me.LayoutPanel(Me.mWidth, Me.mHeight)
        Me.RefreshEnabled()
    End Sub

    Public Property SelectedModel As String
        Get
            Dim index As Integer = Me.mModel.SelectedIndex
            If index < 0 Or index >= Array.Count(Me.mModelIds) Then Return ""
            Return Me.mModelIds(index)
        End Get
    End Property

    Public Sub SelectModel(model As String)
        If Me.mBusy Then Throw New InvalidArgumentException("Cannot change model during a turn")
        For index As Integer = 0 To Array.Count(Me.mModelIds) - 1
            If Me.mModelIds(index) = model Then
                Me.mModel.SelectedIndex = index
                Return
            End If
        Next
        Throw New InvalidArgumentException("Unknown model")
    End Sub

    Public Sub SelectProvider(providerId As String)
        If Me.mBusy Then Throw New InvalidArgumentException("Cannot change provider during a turn")
        For i As Integer = 0 To Array.Count(Me.mProviders) - 1
            If Me.mProviders(i).Id = providerId Then
                Me.mProvider.SelectedIndex = i
                Me.NotifyProviderChanged()
                Return
            End If
        Next
        Throw New InvalidArgumentException("Unknown provider")
    End Sub

    Public Property SelectedProviderId As String
        Get
            Dim index As Integer = Me.mProvider.SelectedIndex
            If index < 0 Or index >= Array.Count(Me.mProviders) Then Return ""
            Return Me.mProviders(index).Id
        End Get
    End Property

    Public Property SelectedProviderAvailable As Boolean
        Get
            Dim index As Integer = Me.mProvider.SelectedIndex
            If index < 0 Or index >= Array.Count(Me.mProviders) Then Return False
            Return Me.mProviders(index).Available
        End Get
    End Property

    Private Property SelectedProviderTitle As String
        Get
            Dim index As Integer = Me.mProvider.SelectedIndex
            If index < 0 Or index >= Array.Count(Me.mProviders) Then Return "Assistant"
            Return Me.mProviders(index).Title
        End Get
    End Property

    Public Sub SetContext(items As Array Of ChatContext)
        Dim caption As String = "Context: none"
        Dim seen As New Set Of String()
        For Each item As ChatContext In items
            If item = Nil Then Throw New InvalidArgumentException("Nil context item")
            If seen.Contains(item.ItemId) Then Throw New InvalidArgumentException("Duplicate context item")
            seen.Add(item.ItemId)
        Next
        Me.mContext = Array.Clone(items)
        If Array.Count(items) > 0 Then
            caption = "Context: "
            For i As Integer = 0 To Array.Count(items) - 1
                If i > 0 Then caption += ", "
                caption += items(i).Title + " · v" + String.From(items(i).Version)
            Next
        End If
        Me.mContextLabel.Text = caption
    End Sub

    Public Property ContextIds As Array Of String
        Get
            Dim ids As Array Of String = []
            For Each item As ChatContext In Me.mContext
                ids.Append(item.ItemId)
            Next
            Return ids
        End Get
    End Property

    Public Property ComposerText As String
        Get
            Return Me.mComposer.Text
        End Get
        Set
            Me.mComposer.Text = value
        End Set
    End Property

    Public Property TranscriptText As String
        Get
            Return Me.mTranscript
        End Get
    End Property

    Public Property IsBusy As Boolean
        Get
            Return Me.mBusy
        End Get
    End Property

    Public Property ProposalId As String
        Get
            Return Me.mProposalId
        End Get
    End Property

    ' ── Attachments ──────────────────────────────────────────────────────────

    ''' Files queued for the next prompt. Hosts read this inside SendMessage; the panel clears
    ''' it after a successful send and shows the files on the user's message.
    Public Property PendingAttachments As Array Of ChatAttachment
        Get
            If Me.mSending Then Return Array.Clone(Me.mSendingAttachments)
            Return Array.Clone(Me.mAttachments)
        End Get
    End Property

    Public Sub AddAttachment(attachment As ChatAttachment)
        If attachment = Nil Then Throw New InvalidArgumentException("Attachment is required")
        If Array.Count(Me.mAttachments) >= 16 Then Throw New InvalidArgumentException("At most 16 attachments per message")
        For Each existing As ChatAttachment In Me.mAttachments
            If String.Compare(existing.Path, attachment.Path, True) = 0 Then Return
        Next
        Me.mAttachments.Append(attachment)
        Me.RefreshAttachments()
    End Sub

    Public Sub AttachFile(item As FileSystemItem)
        Me.AddAttachment(ChatAttachment.FromFile(item))
    End Sub

    Public Sub ClearAttachments()
        Me.mAttachments = []
        Me.RefreshAttachments()
    End Sub

    Private Sub RefreshAttachments()
        Dim count As Integer = Array.Count(Me.mAttachments)
        If count = 0 Then
            Me.mAttachmentsLabel.Text = ""
        Else
            Dim names As String = ""
            For Each attachment As ChatAttachment In Me.mAttachments
                If names <> "" Then names += ", "
                names += attachment.Name
            Next
            Me.mAttachmentsLabel.Text = "📎 " + names
        End If
        Dim show As Boolean = count > 0
        If Me.mAttachmentsLabel.Visible <> show Then
            Me.mAttachmentsLabel.Visible = show
            Me.mClearAttachments.Visible = show
            Me.LayoutPanel(Me.mWidth, Me.mHeight)
        End If
    End Sub

    Private Sub ChooseAttachments()
        Dim dialog As New OpenFileDialog()
        dialog.Title = "Attach Files"
        dialog.AllowMultipleFiles = True
        dialog.AddFilter("Images and documents", "*.png;*.jpg;*.jpeg;*.gif;*.webp;*.bmp;*.svg;*.pdf;*.md;*.txt;*.bui;*.json;*.log;*.csv")
        dialog.AddFilter("All Files", "*")
        If Not dialog.Show(Nil) Then Return
        For i As Integer = 0 To dialog.SelectedItemCount - 1
            Me.AttachFile(dialog.SelectedItemAt(i))
        Next
    End Sub

    ' ── Status and busy ──────────────────────────────────────────────────────

    Public Sub SetBusy(busy As Boolean)
        Dim wasBusy As Boolean = Me.mBusy
        Me.mBusy = busy
        If busy And Not wasBusy Then
            Me.mStreamStart = 0
            Me.mStreamChars = 0
            Me.mUsageIn = 0
            Me.mUsageOut = 0
        End If
        If Not busy Then
            If wasBusy Then Me.PublishStats(True)
            Me.CloseAssistantSegment()
            Me.mAssistantContinues = False
        End If
        Me.Run(Me.BusyScript())
        Me.RefreshEnabled()
    End Sub

    Public Sub SetStatus(message As String)
        Me.mStatus.Text = message
        If Me.mBusy Then Me.Run(Me.BusyScript())
    End Sub

    ''' Real token counts from the provider replace the streamed-character estimate.
    Public Sub SetUsage(inputTokens As Integer, outputTokens As Integer)
        Me.mUsageIn = Math.Max(0, inputTokens)
        Me.mUsageOut = Math.Max(0, outputTokens)
        Me.PublishStats(True)
    End Sub

    Private Sub PublishStats(force As Boolean)
        If Me.mLastAssistantId = "" Or (Me.mStreamChars = 0 And Me.mUsageOut = 0) Then Return
        Dim now As Integer = System.Microseconds()
        If Not force And now - Me.mStatsSent < 250000 Then Return
        Me.mStatsSent = now
        Dim estimated As Boolean = Me.mUsageOut = 0
        Dim tokens As Integer = Me.mUsageOut
        If estimated Then tokens = Math.Max(1, (Me.mStreamChars + 3) \ 4)
        Dim elapsed As Integer = 0
        If Me.mStreamStart > 0 Then elapsed = now - Me.mStreamStart
        If Me.mStatsId <> "" And Me.mStatsId <> Me.mLastAssistantId Then
            ' Turn statistics move to the newest reply segment.
            Dim cleared As JSONItem = JSONItem.NewObject()
            cleared.Value("id") = Me.mStatsId
            Me.Emit("setStats", cleared, "stats:" + Me.mStatsId)
        End If
        Me.mStatsId = Me.mLastAssistantId
        Dim args As JSONItem = JSONItem.NewObject()
        args.Value("id") = Me.mLastAssistantId
        args.Value("tokensOut") = tokens
        args.Value("tokensIn") = Me.mUsageIn
        args.Value("elapsedMs") = elapsed \ 1000
        Dim seconds As Double = elapsed
        seconds = seconds / 1000000.0
        If seconds > 0.25 Then
            Dim rate As Double = tokens
            args.Value("tokensPerSecond") = Math.Round(rate / seconds)
        End If
        args.Value("estimated") = estimated
        Me.Emit("setStats", args, "stats:" + Me.mLastAssistantId)
    End Sub

    ''' Ends the open reply segment; text arriving later (after a tool call, card or
    ''' notice) continues the reply in a new segment below it, in transcript order.
    Private Sub CloseAssistantSegment()
        If Me.mAssistantId = "" Then Return
        Dim args As JSONItem = JSONItem.NewObject()
        args.Value("id") = Me.mAssistantId
        Me.Emit("finishMessage", args, "finish:" + Me.mAssistantId)
        Me.mAssistantId = ""
        Me.mAssistantContinues = True
    End Sub

    ' ── Transcript content ───────────────────────────────────────────────────

    ' BUI-802: Win32 TextArea renders CRLF; keep transcript/model data unchanged.
    Private Function DisplayText(text As String) As String
        #If TargetWindows Then
            Return String.Replace(String.Replace(text, "\r\n", "\n", True), "\n", "\r\n", True)
        #Else
            Return text
        #End If
    End Function

    Private Function RoleKind(role As String) As String
        Dim lower As String = String.LCase(role)
        If lower = "you" Or lower = "user" Then Return "user"
        If String.Contains(lower, "error") Or String.Contains(lower, "failed") Then Return "error"
        If lower = "assistant" Or String.Contains(lower, "agent") Or lower = "claude" Or lower = "codex" Or lower = "chatgpt" Then
            If String.Contains(lower, "approval") Then Return "notice"
            Return "assistant"
        End If
        If lower = "system" Then Return "system"
        Return "notice"
    End Function

    Public Sub AppendMessage(role As String, text As String)
        If role = "" Then Throw New InvalidArgumentException("Message role is required")
        Dim kind As String = Me.RoleKind(role)
        Dim author As String = role
        If kind = "assistant" And String.LCase(role) = "assistant" Then author = Me.SelectedProviderTitle
        If kind = "user" Then author = "You"
        Dim attachments As Array Of ChatAttachment = []
        If kind = "user" And Me.mSending Then
            attachments = Me.mSendingAttachments
            Me.mSendingAttachments = []
        End If
        Me.AppendChatMessage(kind, author, text, attachments, role)
    End Sub

    ''' Adds a message with an explicit kind ("user", "assistant", "system", "notice", "error").
    Public Sub AppendChatMessage(kind As String, author As String, text As String, attachments As Array Of ChatAttachment, transcriptRole As String = "")
        Dim role As String = transcriptRole
        If role = "" Then role = author
        If Me.mTranscript <> "" Then Me.mTranscript += "\n\n"
        Me.mTranscript += role + "\n" + text
        For Each attachment As ChatAttachment In attachments
            Me.mTranscript += "\n[attachment] " + attachment.Name
        Next
        If Me.mRichState = 2 Then Me.mTranscriptArea.Text = Me.DisplayText(Me.mTranscript)
        If kind = "assistant" And text = "" And Array.Count(attachments) = 0 Then
            ' An empty reply placeholder renders nothing until text streams in.
            Me.CloseAssistantSegment()
            Me.mAssistantAuthor = author
            Me.mAssistantContinues = False
            Return
        End If
        Me.EmitMessage(kind, author, text, attachments)
    End Sub

    ''' Adds the rich message only; the plain transcript is maintained by the caller.
    Private Sub EmitMessage(kind As String, author As String, text As String, attachments As Array Of ChatAttachment)
        Me.CloseAssistantSegment()
        Me.mMessageCounter += 1
        Dim id As String = "m" + String.From(Me.mMessageCounter)
        Dim args As JSONItem = JSONItem.NewObject()
        args.Value("id") = id
        args.Value("role") = kind
        args.Value("author") = author
        args.Value("text") = text
        Dim list As JSONItem = JSONItem.NewArray()
        For Each attachment As ChatAttachment In attachments
            list.Add(attachment.ToJSON())
        Next
        args.Value("attachments") = list
        If kind = "assistant" Then args.Value("continuation") = Me.mAssistantContinues
        Me.Emit("addMessage", args, "message:" + id)
        If kind = "assistant" Then
            Me.mAssistantId = id
            Me.mLastAssistantId = id
            Me.mAssistantAuthor = author
            If text <> "" Then Me.CountStreamed(text)
        ElseIf kind = "user" Then
            ' The next streamed text starts a fresh assistant reply with its own header.
            Me.mAssistantContinues = False
            Me.mLastAssistantId = ""
            Me.mStatsId = ""
            Me.mAssistantAuthor = ""
        End If
    End Sub

    Private Sub CountStreamed(text As String)
        If Me.mStreamStart = 0 Then Me.mStreamStart = System.Microseconds()
        Me.mStreamChars += String.Len(text)
    End Sub

    Public Sub AppendAssistantDelta(text As String)
        If text = "" Then Return
        Me.mTranscript += text
        If Me.mRichState = 2 Then Me.mTranscriptArea.Text = Me.DisplayText(Me.mTranscript)
        If Me.mAssistantId = "" Then
            Dim noAttachments As Array Of ChatAttachment = []
            Dim author As String = Me.mAssistantAuthor
            If author = "" Then author = Me.SelectedProviderTitle
            Me.EmitMessage("assistant", author, "", noAttachments)
        End If
        Dim stored As JSONItem = Me.FindOp("message:" + Me.mAssistantId)
        If stored <> Nil Then stored.Value("text") = stored.Value("text").AsString().Or("") + text
        Me.CountStreamed(text)
        Dim args As JSONItem = JSONItem.NewObject()
        args.Value("id") = Me.mAssistantId
        args.Value("text") = text
        Me.Run("chat.appendDelta(" + Json.Stringify(args) + ");")
        Me.PublishStats(False)
    End Sub

    Public Sub AppendToolActivity(toolId As String, title As String, status As String)
        Me.AppendToolCall(toolId, title, status, "", "", "")
    End Sub

    ''' Inline tool row. Later calls with the same toolId update the row in place.
    ''' status: "running", "complete" or "failed" (other text is shown as detail).
    Public Sub AppendToolCall(toolId As String, name As String, status As String, detail As String, input As String, output As String)
        If toolId = "" Then Throw New InvalidArgumentException("Tool ID is required")
        If Not Me.mTools.ContainsKey(toolId) Then
            Me.mToolOrder.Append(toolId)
            Me.CloseAssistantSegment()
        End If
        Me.mTools.Set(toolId, name + " · " + status)
        Dim state As String = String.LCase(status)
        Dim shownDetail As String = detail
        If state <> "running" And state <> "complete" And state <> "failed" Then
            If shownDetail = "" Then shownDetail = status
            state = "complete"
            If String.Contains(String.LCase(status), "fail") Or String.Contains(String.LCase(status), "error") Then state = "failed"
            If String.Contains(String.LCase(status), "start") Or String.Contains(String.LCase(status), "progress") Then state = "running"
        End If
        Dim args As JSONItem = JSONItem.NewObject()
        args.Value("id") = toolId
        args.Value("name") = name
        args.Value("status") = state
        args.Value("detail") = shownDetail
        If input <> "" Then args.Value("input") = String.Left(input, 65536)
        If output <> "" Then args.Value("output") = String.Left(output, 65536)
        Me.Emit("upsertTool", args, "tool:" + toolId)
        If Me.mRichState = 2 Then Me.RenderActivity()
        If Array.Count(Me.mToolOrder) = 1 Then Me.LayoutPanel(Me.mWidth, Me.mHeight)
    End Sub

    Private Sub RenderActivity()
        Dim text As String = ""
        For Each key As String In Me.mToolOrder
            If text <> "" Then text += "\n"
            text += Me.mTools.Get(key).Or("")
        Next
        Me.mActivity.Text = Me.DisplayText(text)
    End Sub

    ' ── Proposal and permission cards ────────────────────────────────────────

    Public Sub ShowProposal(proposalId As String, preview As String)
        Dim files As Array Of ChatFileChange = []
        Me.ShowProposalChanges(proposalId, "", preview, files)
    End Sub

    ''' Proposal card with per-file unified diffs. `preview` is the plain-text fallback.
    Public Sub ShowProposalChanges(proposalId As String, title As String, preview As String, files As Array Of ChatFileChange)
        If proposalId = "" Then Throw New InvalidArgumentException("Proposal ID is required")
        Me.CloseAssistantSegment()
        Me.ResolveCurrentCard("dismissed")
        Me.mPermission = False
        Me.mApprove.Caption = "Apply changes"
        Me.mReject.Caption = "Reject"
        Me.mProposalId = proposalId
        Me.mCardId = "proposal-" + proposalId
        Me.mProposal.Text = Me.DisplayText(preview)
        Dim args As JSONItem = JSONItem.NewObject()
        args.Value("id") = Me.mCardId
        args.Value("title") = title
        args.Value("canApply") = True
        Dim list As JSONItem = JSONItem.NewArray()
        For Each change As ChatFileChange In files
            Dim entry As JSONItem = JSONItem.NewObject()
            entry.Value("path") = change.Path
            entry.Value("revision") = change.Revision
            entry.Value("added") = change.Added
            entry.Value("removed") = change.Removed
            entry.Value("diff") = change.DiffText
            list.Add(entry)
        Next
        If Array.Count(files) = 0 And preview <> "" Then
            Dim entry As JSONItem = JSONItem.NewObject()
            entry.Value("path") = "Preview"
            ' Render preview text as unchanged context lines of a diff block.
            Dim contextLines As String = ""
            For Each line As String In String.Split(preview, "\n")
                If contextLines <> "" Then contextLines += "\n"
                contextLines += " " + line
            Next
            entry.Value("diff") = contextLines
            list.Add(entry)
        End If
        args.Value("files") = list
        Me.Emit("showProposal", args, "card:" + Me.mCardId)
        Me.ReviveCard(Me.mCardId)
        Me.RefreshEnabled()
        Me.LayoutPanel(Me.mWidth, Me.mHeight)
    End Sub

    Public Sub ShowPermission(title As String, details As String, canAccept As Boolean = True)
        Me.CloseAssistantSegment()
        Me.ResolveCurrentCard("dismissed")
        Me.mPermission = True
        Me.mPermissionCanAccept = canAccept
        Me.mProposalId = ""
        Me.mCardCounter += 1
        Me.mCardId = "permission-" + String.From(Me.mCardCounter)
        Me.mProposal.Text = Me.DisplayText(title + "\n" + details)
        Me.mApprove.Caption = "Allow once"
        Me.mReject.Caption = "Deny"
        Dim args As JSONItem = JSONItem.NewObject()
        args.Value("id") = Me.mCardId
        args.Value("title") = title
        args.Value("details") = String.Left(details, 65536)
        args.Value("canAccept") = canAccept
        Me.Emit("showPermission", args, "card:" + Me.mCardId)
        Me.ReviveCard(Me.mCardId)
        Me.RefreshEnabled()
        Me.LayoutPanel(Me.mWidth, Me.mHeight)
    End Sub

    Private Sub ResolveCurrentCard(outcome As String)
        If Me.mCardId = "" Then Return
        Dim args As JSONItem = JSONItem.NewObject()
        args.Value("id") = Me.mCardId
        args.Value("outcome") = outcome
        Me.Emit("resolveCard", args, "resolve:" + Me.mCardId)
        Me.mCardId = ""
    End Sub

    Public Sub ClearProposal()
        Me.ResolveCurrentCard("dismissed")
        Me.mPermission = False
        Me.mApprove.Caption = "Apply changes"
        Me.mReject.Caption = "Reject"
        Me.mProposalId = ""
        Me.mProposal.Text = Me.DisplayText("Proposed project changes appear here.\nThe project remains unchanged until Apply changes.")
        Me.RefreshEnabled()
        Me.LayoutPanel(Me.mWidth, Me.mHeight)
    End Sub

    ' ── Actions ──────────────────────────────────────────────────────────────

    Private Sub RefreshEnabled()
        Dim account As Boolean = TryCast(Me.mHost, ChatPanelAccountHost) <> Nil
        Me.mAuth.Enabled = Me.mAuth.Visible And Not Me.mBusy And Not Me.mAuthBusy And Me.mHost <> Nil And (Not Me.mAuthenticated Or account)
        Me.mProvider.Enabled = Not Me.mBusy
        Me.mModel.Enabled = Not Me.mBusy
        Me.mComposer.Enabled = Not Me.mBusy
        Me.mAttach.Enabled = Not Me.mBusy
        Me.mClearAttachments.Enabled = Not Me.mBusy
        Me.mSend.Enabled = Not Me.mBusy And Me.mHost <> Nil And Me.SelectedProviderAvailable
        Me.mCancel.Enabled = Me.mBusy And Me.mHost <> Nil
        Me.mApprove.Enabled = ((Me.mPermission And Me.mPermissionCanAccept) Or (Me.mProposalId <> "" And Not Me.mBusy)) And Me.mHost <> Nil
        Me.mReject.Enabled = (Me.mPermission Or (Me.mProposalId <> "" And Not Me.mBusy)) And Me.mHost <> Nil
        ' Switching to web needs a usable engine; native is always available.
        Me.mViewMode.Enabled = Me.mRichState <> 2 Or ChatPanel.WebTranscriptBlocker() = ""
    End Sub

    Internal Sub NotifyProviderChanged()
        Dim index As Integer = Me.mProvider.SelectedIndex
        If index >= 0 And index < Array.Count(Me.mProviders) Then Me.mStatus.Text = Me.mProviders(index).Detail
        Me.RefreshEnabled()
        If Me.mHost <> Nil Then Me.mHost.ProviderChanged(Me.SelectedProviderId)
    End Sub

    Internal Sub Activate(actionName As String)
        Select Case actionName
            Case "attach"
                If Not Me.mBusy Then Me.ChooseAttachments()
                Return
            Case "clear-attachments"
                If Not Me.mBusy Then Me.ClearAttachments()
                Return
            Case "copy-transcript"
                Me.CopyTranscript()
                Return
            Case "toggle-view"
                Me.ToggleTranscriptMode()
                Return
        End Select
        If Me.mHost = Nil Then Return
        Select Case actionName
            Case "auth"
                If Not Me.mAuth.Visible Or Me.mBusy Or Me.mAuthBusy Then Return
                If Me.mAuthenticated Then
                    Dim account As ChatPanelAccountHost = TryCast(Me.mHost, ChatPanelAccountHost)
                    If account <> Nil Then account.SignOutOfChatGPT()
                Else
                    Me.mHost.SignInWithChatGPT()
                End If
            Case "send"
                If Me.mBusy Or Me.mSending Or Not Me.SelectedProviderAvailable Or String.Trim(Me.mComposer.Text) = "" Then Return
                Dim prompt As String = Me.mComposer.Text
                Dim sending As Array Of ChatAttachment = Array.Clone(Me.mAttachments)
                Me.mSendingAttachments = sending
                Me.mSending = True
                Try
                    Me.mHost.SendMessage(Me.SelectedProviderId, prompt, Me.ContextIds)
                    If String.Compare(Me.mComposer.Text, prompt, True) = 0 Then Me.mComposer.Text = ""
                    Me.mAttachments = []
                    Me.RefreshAttachments()
                Finally
                    Me.mSending = False
                    Me.mSendingAttachments = []
                End Try
            Case "cancel"
                If Me.mBusy Then Me.mHost.CancelTurn()
            Case "approve"
                If Me.mPermission Then
                    If Not Me.mPermissionCanAccept Then Return
                    Me.ResolveCurrentCard("allowed")
                    Me.ClearProposal()
                    Me.mHost.ResolvePermission(True)
                    Return
                End If
                If Me.mProposalId <> "" And Not Me.mBusy Then
                    Dim proposalId As String = Me.mProposalId
                    Me.ResolveCurrentCard("applied")
                    Me.ClearProposal()
                    Me.mHost.ApproveProposal(proposalId)
                End If
            Case "reject"
                If Me.mPermission Then
                    Me.ResolveCurrentCard("denied")
                    Me.ClearProposal()
                    Me.mHost.ResolvePermission(False)
                    Return
                End If
                If Me.mProposalId <> "" And Not Me.mBusy Then
                    Dim proposalId As String = Me.mProposalId
                    Me.ResolveCurrentCard("rejected")
                    Me.ClearProposal()
                    Me.mHost.RejectProposal(proposalId)
                End If
        End Select
    End Sub

    Public Sub PerformSignIn()
        Me.mAuth.InvokeAction()
    End Sub

    Public Sub PerformSend()
        Me.mSend.InvokeAction()
    End Sub
    Public Sub PerformCancel()
        Me.mCancel.InvokeAction()
    End Sub
    Public Sub PerformApprove()
        Me.mApprove.InvokeAction()
    End Sub
    Public Sub PerformReject()
        Me.mReject.InvokeAction()
    End Sub
    ''' Test hook: deliver a page message as if the transcript posted it.
    Public Sub PerformPageMessage(message As String)
        Me.AcceptPageMessage(message)
    End Sub

    ' ── Transcript copy and view mode ────────────────────────────────────────

    ''' Switches between the web (WebKit/WebView2) and native transcripts and tells a
    ''' ChatPanelViewHost so it can persist the choice.
    Public Sub ToggleTranscriptMode()
        Dim wasPlain As Boolean = Me.mRichState = 2
        If wasPlain Then
            Me.UseRichTranscript()
        Else
            Me.UsePlainTranscript()
        End If
        Dim nowPlain As Boolean = Me.mRichState = 2
        ' A blocked web engine leaves the panel native: nothing changed, nothing to persist.
        If nowPlain = wasPlain Then Return
        Dim viewHost As ChatPanelViewHost = TryCast(Me.mHost, ChatPanelViewHost)
        If viewHost <> Nil Then viewHost.TranscriptModeChanged(nowPlain)
    End Sub

    ''' Puts the full raw conversation (RawTranscriptText) on the clipboard.
    Public Sub CopyTranscript()
        Dim text As String = Me.RawTranscriptText
        If text = "" Then
            Me.SetStatus("The conversation is empty")
            Return
        End If
        Dim board As New Clipboard()
        board.Text = text
        Me.SetStatus("Copied the full conversation")
    End Sub

    ''' True when the web transcript holds keyboard focus, so Edit > Copy and Select All
    ''' belong to it. The native transcript is a TextArea and handles those itself.
    Public Property TranscriptHasFocus As Boolean
        Get
            If Me.mRichState <> 1 Or Me.mTranscriptView = Nil Then Return False
            If Not Me.mTranscriptView.Visible Then Return False
            ' A focused native field in the panel always owns its own edit commands.
            If Me.mComposer.HasFocus() Or Me.mTranscriptArea.HasFocus() Then Return False
            If Me.mPageFocused Or Me.mTranscriptView.HasFocus() Then Return True
            #If TargetMac Then
                ' AppKit menus never take focus from the page; no grace period needed.
                Return False
            #Else
                Return Me.mPageBlurAt > 0 And System.Microseconds() - Me.mPageBlurAt < ChatPanel.BlurGraceMicroseconds
            #End If
        End Get
    End Property

    ''' Copies the web transcript's current text selection (asynchronous: the page replies).
    Public Sub CopyTranscriptSelection()
        If Me.mRichState = 1 Then
            Me.Run("chat.copySelection();")
            Return
        End If
        Me.CopyTranscript()
    End Sub

    ''' Selects the whole web transcript. The native transcript only takes focus; its
    ''' TextArea answers the platform Select All command itself.
    Public Sub SelectAllTranscript()
        If Me.mRichState = 1 Then
            Me.Run("chat.selectAll();")
            Return
        End If
        Me.mTranscriptArea.SetFocus()
    End Sub

    ''' True when the conversation has any content (cheap; for menu enabling).
    Public Property HasTranscript As Boolean
        Get
            Return Array.Count(Me.mOps) > 0 Or Me.mTranscript <> ""
        End Get
    End Property

    ''' The last assistant reply as plain text, or "".
    Public Property LastReplyText As String
        Get
            Dim reply As String = ""
            Dim collecting As Boolean = False
            For Each op As JSONItem In Me.mOps
                If op.Value("fn").AsString().Or("") = "addMessage" Then
                    Dim args As JSONItem = op.Value("args")
                    Dim role As String = args.Value("role").AsString().Or("")
                    If role = "assistant" Then
                        Dim text As String = args.Value("text").AsString().Or("")
                        If args.Value("continuation").AsBoolean().Or(False) And collecting Then
                            If reply <> "" And text <> "" Then reply += "\n\n"
                            reply += text
                        Else
                            reply = text
                        End If
                        collecting = True
                    ElseIf role = "user" Then
                        collecting = False
                    End If
                End If
            Next
            Return reply
        End Get
    End Property

    ''' The entire conversation as plain Markdown-style text: every message, tool call
    ''' (with input and output), proposal diff, permission request and outcome, in order.
    ''' Identical in web and native modes.
    Public Property RawTranscriptText As String
        Get
            Dim outcomes As Map Of String, String = New Map Of String, String()
            For Each op As JSONItem In Me.mOps
                If op.Value("fn").AsString().Or("") = "resolveCard" Then
                    Dim resolved As JSONItem = op.Value("args")
                    outcomes.Set(resolved.Value("id").AsString().Or(""), resolved.Value("outcome").AsString().Or(""))
                End If
            Next
            Dim out As String = ""
            ' Kind of the last section written: a reply continued after anything but its
            ' own text or a tool row gets its author header again.
            Dim lastKind As String = ""
            For Each op As JSONItem In Me.mOps
                Dim fn As String = op.Value("fn").AsString().Or("")
                Dim args As JSONItem = op.Value("args")
                Dim section As String = ""
                Select Case fn
                    Case "addMessage"
                        Dim text As String = args.Value("text").AsString().Or("")
                        Dim role As String = args.Value("role").AsString().Or("")
                        Dim continued As Boolean = args.Value("continuation").AsBoolean().Or(False) And (lastKind = "assistant" Or lastKind = "tool")
                        If Not continued Then section = "## " + args.Value("author").AsString().Or(role) + "\n\n"
                        section += text
                        Dim files As JSONItem = args.Value("attachments")
                        If files <> Nil And files.IsArray() Then
                            For i As Integer = 0 To files.Count - 1
                                section += "\n[attachment] " + files.ValueAt(i).Value("name").AsString().Or("")
                            Next
                        End If
                        If continued And String.Trim(section) = "" Then section = ""
                        If section <> "" Then lastKind = role
                    Case "upsertTool"
                        section = "> Tool: " + args.Value("name").AsString().Or("") + " (" + args.Value("status").AsString().Or("") + ")"
                        Dim detail As String = args.Value("detail").AsString().Or("")
                        If detail <> "" Then section += "\n> " + String.Replace(detail, "\n", "\n> ", True)
                        Dim input As String = args.Value("input").AsString().Or("")
                        If input <> "" Then section += "\n\nInput:\n```\n" + input + "\n```"
                        Dim output As String = args.Value("output").AsString().Or("")
                        If output <> "" Then section += "\n\nOutput:\n```\n" + output + "\n```"
                        lastKind = "tool"
                    Case "showProposal"
                        Dim title As String = args.Value("title").AsString().Or("")
                        section = "### Proposed changes" + If(title = "", "", ": " + title)
                        lastKind = "card"
                        Dim changes As JSONItem = args.Value("files")
                        If changes <> Nil And changes.IsArray() Then
                            For i As Integer = 0 To changes.Count - 1
                                Dim change As JSONItem = changes.ValueAt(i)
                                section += "\n\n" + change.Value("path").AsString().Or("") + "\n```diff\n" + change.Value("diff").AsString().Or("") + "\n```"
                            Next
                        End If
                        Dim outcome As String = outcomes.Get(args.Value("id").AsString().Or("")).Or("")
                        If outcome <> "" Then section += "\n\nOutcome: " + outcome
                    Case "showPermission"
                        section = "### Permission requested: " + args.Value("title").AsString().Or("")
                        lastKind = "card"
                        Dim details As String = args.Value("details").AsString().Or("")
                        If details <> "" Then section += "\n\n" + details
                        Dim outcome As String = outcomes.Get(args.Value("id").AsString().Or("")).Or("")
                        If outcome <> "" Then section += "\n\nOutcome: " + outcome
                End Select
                If section <> "" Then
                    If out <> "" Then out += "\n\n"
                    out += section
                End If
            Next
            If out = "" Then Return Me.mTranscript
            Return out + "\n"
        End Get
    End Property

    ' Read-only native frames for layout diagnostics; no conversation data is exposed.
    Public Function LayoutFrames() As Array Of JSONItem
        Return [FrameRecord("heading", Me.mHeading), FrameRecord("auth", Me.mAuth), FrameRecord("provider", Me.mProvider), FrameRecord("model", Me.mModel), FrameRecord("context", Me.mContextLabel), FrameRecord("copyTranscript", Me.mCopyAll), FrameRecord("viewMode", Me.mViewMode), FrameRecord("transcript", Me.mTranscriptArea), ViewFrameRecord("transcriptView"), FrameRecord("activity", Me.mActivity), FrameRecord("proposal", Me.mProposal), FrameRecord("attachments", Me.mAttachmentsLabel), FrameRecord("composer", Me.mComposer), FrameRecord("attach", Me.mAttach), FrameRecord("send", Me.mSend), FrameRecord("cancel", Me.mCancel), FrameRecord("approve", Me.mApprove), FrameRecord("reject", Me.mReject), FrameRecord("status", Me.mStatus)]
    End Function

    Private Function ViewFrameRecord(name As String) As JSONItem
        If Me.mTranscriptView <> Nil Then Return FrameRecord(name, Me.mTranscriptView)
        Dim value As JSONItem = JSONItem.NewObject()
        value.Value("name") = JSONItem.From(name)
        value.Value("x") = JSONItem.From(0)
        value.Value("y") = JSONItem.From(0)
        value.Value("width") = JSONItem.From(0)
        value.Value("height") = JSONItem.From(0)
        value.Value("visible") = JSONItem.From(False)
        Return value
    End Function

    Private Function FrameRecord(name As String, widget As UIControl) As JSONItem
        Dim value As JSONItem = JSONItem.NewObject()
        value.Value("name") = JSONItem.From(name)
        value.Value("x") = JSONItem.From(widget.X)
        value.Value("y") = JSONItem.From(widget.Y)
        value.Value("width") = JSONItem.From(widget.Width)
        value.Value("height") = JSONItem.From(widget.Height)
        value.Value("visible") = JSONItem.From(widget.Visible)
        Return value
    End Function

    ''' Invoke after resizing the surrounding View. Minimum usable panel is 240 by 320.
    ''' In rich mode tool activity and proposal/permission cards render inline in the
    ''' transcript; the plain fallback gives them native areas while they have content.
    Public Sub LayoutPanel(width As Integer, height As Integer)
        Dim w As Integer = Math.Max(width, 240)
        Dim h As Integer = Math.Max(height, 320)
        Me.mWidth = width
        Me.mHeight = height
        Dim rich As Boolean = Me.mRichState <> 2
        Dim inlineCards As Boolean = Me.mRichState = 1
        Dim authWidth As Integer = Math.Min(176, w - 80)
        If Me.mAuth.Caption = "Sign out" Then authWidth = Math.Min(96, authWidth)
        Dim headingWidth As Integer = w
        If Me.mAuth.Visible Then headingWidth = Math.Max(60, w - authWidth - 8)
        Me.mHeading.Move(0, 4, headingWidth, 20)
        Me.mAuth.Move(w - authWidth, 0, authWidth, 26)
        Dim modelHeight As Integer = 0
        If Me.mModel.Visible And h < 420 Then
            ' Compact panels: provider and model share one row so the transcript keeps room.
            Dim half As Integer = (w - 6) \ 2
            Me.mProvider.Move(0, 34, half, 26)
            Me.mModel.Move(w - half, 34, half, 26)
        Else
            Me.mProvider.Move(0, 34, w, 26)
            If Me.mModel.Visible Then modelHeight = 32
            Me.mModel.Move(0, 66, w, 26)
        End If
        ' Transcript toolbar shares the context row (no extra height at the minimum size):
        ' copy the whole chat and switch web/native rendering.
        Dim toolY As Integer = 63 + modelHeight
        Dim toolWidth As Integer = Math.Min(92, (w - 48) \ 2)
        Me.mViewMode.Move(w - toolWidth, toolY, toolWidth, 24)
        Me.mCopyAll.Move(w - 2 * toolWidth - 6, toolY, toolWidth, 24)
        Me.mContextLabel.Move(0, 67 + modelHeight, Math.Max(24, w - 2 * toolWidth - 12), 16)
        Dim bottom As Integer = h - 18
        Me.mStatus.Move(0, bottom + 2, w, 16)
        bottom -= 34
        Me.mSend.Move(w - 80, bottom, 80, 28)
        Me.mCancel.Move(w - 168, bottom, 80, 28)
        Me.mAttach.Move(0, bottom, Math.Min(88, Math.Max(40, w - 176)), 28)
        Dim composerHeight As Integer = 64
        Dim cardHeight As Integer = 96
        Dim activityHeight As Integer = 44
        If h < 520 Then
            composerHeight = 56
            cardHeight = 64
            activityHeight = 32
        End If
        If h < 420 Then
            composerHeight = 40
            cardHeight = 32
            activityHeight = 20
        End If
        bottom -= composerHeight + 8
        Me.mComposer.Move(0, bottom, w, composerHeight)
        If Me.mAttachmentsLabel.Visible Then
            bottom -= 26
            Me.mAttachmentsLabel.Move(0, bottom + 4, Math.Max(40, w - 64), 16)
            Me.mClearAttachments.Move(w - 60, bottom, 60, 22)
        End If
        ' The transcript keeps at least 16 px: the fallback card shrinks and the activity
        ' box is dropped before anything could overlap at the 240 x 320 minimum.
        Dim top As Integer = 90 + modelHeight
        Dim showCard As Boolean = (Me.mPermission Or Me.mProposalId <> "")
        Me.mProposal.Visible = showCard And Not inlineCards
        Me.mApprove.Visible = showCard And Not inlineCards And (Not Me.mPermission Or Me.mPermissionCanAccept)
        Me.mReject.Visible = showCard And Not inlineCards
        If showCard And Not inlineCards Then
            cardHeight = Math.Max(16, Math.Min(cardHeight, bottom - 36 - 8 - 8 - 16 - top))
            bottom -= 36
            Me.mApprove.Move(0, bottom, 136, 28)
            Dim rejectLeft As Integer = 144
            If Me.mPermission And Not Me.mPermissionCanAccept Then rejectLeft = 0
            Me.mReject.Move(rejectLeft, bottom, 84, 28)
            bottom -= cardHeight + 8
            Me.mProposal.Move(0, bottom, w, cardHeight)
        End If
        Dim showActivity As Boolean = Array.Count(Me.mToolOrder) > 0 And Not rich And bottom - activityHeight - 8 - 8 - top >= 16
        Me.mActivity.Visible = showActivity
        If showActivity Then
            bottom -= activityHeight + 8
            Me.mActivity.Move(0, bottom, w, activityHeight)
        End If
        Dim transcriptHeight As Integer = Math.Max(16, bottom - 8 - top)
        Me.mTranscriptArea.Move(0, top, w, transcriptHeight)
        If Me.mTranscriptView <> Nil Then Me.mTranscriptView.Move(0, top, w, transcriptHeight)
    End Sub
End Class

